# Build WAMP : ce fichier DOIT rester versionné (active le mode MySQL).
!.env.wamp

# WAMP : secrets locaux, journaux et sauvegardes — jamais versionnés.
wamp_deploy/api/config.local.php
wamp_deploy/api/logs/*.log
wamp_deploy/sauvegardes/

# Tests navigateur et outils locaux
.arena/
test-results/
playwright-report/

# Gestionnaire officiel : npm (package-lock.json). Pas de lockfile bun — il fait
# echouer le deploiement (le bun 1.2.15 distant ne lit pas bun.lock v2).
bun.lock
bun.lockb
